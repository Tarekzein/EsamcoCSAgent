# Copy to .env and fill in for your environment. Loaded automatically at
# startup via python-dotenv (see app/config.py).

# Groq API key - the only variable the app actually reads. The client is
# built at import time (app/core/groq_client.py:4), so the process dies on
# startup if this is missing. Free key: https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=