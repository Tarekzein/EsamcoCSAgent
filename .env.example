# Copy to .env and fill in for your environment. Loaded automatically at
# startup via python-dotenv (see app/config.py).

# Where Ollama is reachable from this service. Only needs to change if
# Ollama runs on a different host/port than this app (e.g. a separate
# GPU box) - defaults to the same machine.
OLLAMA_BASE_URL=http://localhost:11434
